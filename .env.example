# ==============================================================================
# VARIABLES DE ENTORNO - PagoBolsista Generator (Arquitectura Distribuida)
# Copia este archivo como .env y edita los valores para tu entorno.
# NUNCA subas archivos .env con credenciales reales al repositorio.
# ==============================================================================

# ── AMBIENTE GENERAL ─────────────────────────────────────────────────────────
ENV=local
PORT=8000
API_URL=http://localhost:8000

# ── RETO 1: MIDDLEWARE (RABBITMQ / CLOUDAMQP) ─────────────────────────────────
# Opción A (Local Docker Compose):
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Opción B (CloudAMQP en la Nube - Si se define, toma precedencia sobre la local):
# AMQP_URL=amqps://usuario:password@cougar.rmq.cloudamqp.com/vhost

# ── RETO 5: SERVERLESS FaaS (AWS LAMBDA / CORREO) ─────────────────────────────
# En modo DRY_RUN=true se simula el envío registrando los logs para la demo (A prueba de fallas)
DRY_RUN=true

# Opcional: URL pública de AWS Lambda Function URL si está desplegada en AWS:
# LAMBDA_URL=https://xxxxxxxxxxxxxx.lambda-url.us-east-1.on.aws/

# Opcional: Credenciales SMTP para envío de correos reales cuando DRY_RUN=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones.unmsm@gmail.com
SMTP_PASS=tu_app_password_aqui
